{
  "name": "xitdb",
  "version": "0.18.0",
  "description": "An immutable database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xit-vcs/xitdb-ts.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
